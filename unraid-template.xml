<?xml version="1.0"?>
<Container version="2">
  <Name>cockroach-the-game</Name>
  <Repository>ghcr.io/pawcza/cockroach-the-game:latest</Repository>
  <Registry>https://ghcr.io/pawcza/cockroach-the-game</Registry>
  <Network>proxynet</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project>https://github.com/pawcza/cockroach-the-game</Project>
  <Overview>2D side-scrolling Phaser 3 game with socket.io multiplayer.</Overview>
  <Category>GameServers: HomeAutomation:</Category>
  <WebUI>http://[IP]:[PORT:3000]</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Description>Cockroach the Game — Phaser 3 + Express + socket.io. SQLite scoreboard persisted to /data.</Description>
  <Networking>
    <Mode>proxynet</Mode>
    <Publish>
      <Port>
        <HostPort>3000</HostPort>
        <ContainerPort>3000</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/cockroach-game-data</HostDir>
      <ContainerDir>/data</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Value>3000</Value>
      <Name>PORT</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>/data/scores.db</Value>
      <Name>DB_PATH</Name>
      <Mode/>
    </Variable>
  </Environment>
  <Config Name="WebUI" Target="3000" Default="3000" Mode="tcp" Description="HTTP + socket.io port" Type="Port" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/cockroach-game-data" Mode="rw" Description="SQLite scores DB" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/cockroach-game-data</Config>
  <Config Name="PORT" Target="PORT" Default="3000" Mode="" Description="Port the server listens on inside the container" Type="Variable" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="DB_PATH" Target="DB_PATH" Default="/data/scores.db" Mode="" Description="SQLite DB path inside the container" Type="Variable" Display="advanced" Required="true" Mask="false">/data/scores.db</Config>
</Container>
