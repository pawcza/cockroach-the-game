{
  "name": "cockroach-the-game",
  "version": "1.0.0",
  "description": "A multiplayer cockroach runner for the browser, built with Phaser 3, TypeScript and Socket.IO",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,yellow \"vite\" \"tsx watch --env-file-if-exists=.env server/index.ts\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server:dev": "tsx server/index.ts",
    "server:build": "npx tsc -p server/tsconfig.json",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "author": "Paweł Czarniecki",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "private": true
}
